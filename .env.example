# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Security & JWT
SECRET_KEY=your-jwt-secret-key

# Groq AI Service
GROQ_API_KEY=gsk_your_groq_api_key

# SMTP Configuration for Email OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Agora RTC & RTM Real-Time Voice Credentials
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Public Server Base URL
PUBLIC_SERVER_URL=https://your-ngrok-subdomain.ngrok-free.app

# Real-Time Voice Analysis Chunking Settings
VOICE_ANALYSIS_CHUNK_SECONDS=3.0
VOICE_ANALYSIS_INTERVAL_SECONDS=3.0

# AASIST Deepfake AI Voice Detector Model Path, Threshold, Temperature, and Min RMS Energy
AASIST_MODEL_PATH=model/aasist_truvoice_epoch6_best.pth
AASIST_THRESHOLD=0.5
AASIST_TEMPERATURE=15.0
AASIST_MIN_RMS=0.003


